# ══════════════════════════════════════════════════════════
#  Musikschule Telegram Admin Bot — Environment Variables
# ══════════════════════════════════════════════════════════
#
# Копируй в /etc/music_school.env на сервере (добавляй к уже существующим переменным).
# На локальной машине создай файл .env рядом с server.ts и
# запусти: set -a && source .env && set +a
#
# ──────────────────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────────────────
# Токен от @BotFather (формат: 123456789:AAEQ…)
TELEGRAM_BOT_TOKEN=

# Случайная строка для верификации запросов от Telegram.
# НЕ токен бота! Генерируй: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Разрешённые пользователи — числовые Telegram user ID (через запятую).
# Узнать свой ID: напиши @userinfobot в Telegram.
TELEGRAM_ALLOWED_USERS=

# ── Gemini CLI ────────────────────────────────────────────
# Авторизация — через OAuth: `gemini auth login` (НЕ API-ключ)
# Модель — может быть изменена без перезапуска (только перезапустить сервис)
GEMINI_MODEL=gemini-2.5-pro

# Таймаут (мс) для дочернего процесса Gemini CLI
GEMINI_TIMEOUT_MS=120000

# ── HTTPS Server ──────────────────────────────────────────
# Порт 8443 нативно поддерживается Telegram для webhooks
BOT_PORT=8443
BOT_HOST=0.0.0.0

# Пути к Let's Encrypt сертификатам (те же, что использует nginx)
SSL_CERT=/etc/letsencrypt/live/musikschule-cms-bielefeld.de/fullchain.pem
SSL_KEY=/etc/letsencrypt/live/musikschule-cms-bielefeld.de/privkey.pem

# ── Site / Repo ───────────────────────────────────────────
# Абсолютный путь к корню репозитория сайта на сервере
SITE_REPO_PATH=/home/ubuntu/Rudolf_music_site

# Относительный путь к файлу с контентом (от корня репо)
SITE_CONTENT_FILE=site/src/data/content.js

# ── UX ───────────────────────────────────────────────────
# Время (мс) до автоматической отмены ожидающего подтверждения
CONFIRM_TIMEOUT_MS=300000

# ── Транскрипция голосовых сообщений (AssemblyAI) ────────
# Получить ключ: https://www.assemblyai.com/
# Если не задан — голосовые сообщения не обрабатываются
ASSEMBLYAI_API_KEY=

# Язык транскрипции: 'ru' | 'de' | 'en' | 'auto' (автоопределение)
TRANSCRIPTION_LANGUAGE=ru

# ── Media ─────────────────────────────────────────────────
# Путь к ffmpeg (должен быть установлен на сервере: apt install ffmpeg)
FFMPEG_PATH=ffmpeg

# ── База данных ───────────────────────────────────────────
# SQLite файл для хранения истории диалогов.
# Путь относительно WorkingDirectory сервиса (/services/telegram-bot/)
# или абсолютный. Директория создаётся автоматически.
DB_PATH=data/bot.db
